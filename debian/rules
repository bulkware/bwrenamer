#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	PYTHONPATH=.. python3 -m unittest discover -s tests -v

override_dh_auto_install:
	dh_auto_install
	install -D -m 644 data/org.bulkware.bwrenamer.desktop \
		debian/bwrenamer/usr/share/applications/org.bulkware.bwrenamer.desktop
	install -D -m 644 data/org.bulkware.bwrenamer.metainfo.xml \
		debian/bwrenamer/usr/share/metainfo/org.bulkware.bwrenamer.metainfo.xml
	install -D -m 644 data/icons/hicolor/512x512/apps/org.bulkware.bwrenamer.png \
		debian/bwrenamer/usr/share/icons/hicolor/512x512/apps/org.bulkware.bwrenamer.png
